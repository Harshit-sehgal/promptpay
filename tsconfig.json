{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "paths": {
      "@ateva/agent-protocol": ["./packages/agent-protocol/src"],
      "@ateva/config": ["./packages/config/src"],
      "@ateva/db": ["./packages/db/src"],
      "@ateva/shared": ["./packages/shared/src"],
      "@ateva/ui": ["./packages/ui/src"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "exclude": ["node_modules", "dist", ".next", "apps"]
}

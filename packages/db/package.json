{
  "name": "@ateva/db",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "generate": "prisma generate && node scripts/verify-generated-client.mjs",
    "migrate": "prisma migrate dev",
    "push": "prisma db push",
    "studio": "prisma studio",
    "seed": "tsx prisma/seed-tools.ts",
    "seed:demo": "tsx prisma/seed.ts",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "migrate:drift": "prisma migrate diff --exit-code --from-config-datasource --to-schema prisma/schema.prisma"
  },
  "prisma": {
    "seed": "tsx prisma/seed-tools.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "pg": "^8.23.0",
    "prisma": "^7.10.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "8.23.1",
    "@ateva/eslint-config": "workspace:*",
    "typescript": "^5.9.2"
  }
}

{
  "name": "@ateva/wait-attestation-bridge",
  "version": "0.0.1",
  "private": true,
  "description": "Reference/stub independent wait-attestation provider bridge for local and staging development.",
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./simulator": {
      "types": "./dist/simulator.d.ts",
      "import": "./dist/simulator.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "jose": "^6.2.10"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@ateva/eslint-config": "workspace:*",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vitest": "4.1.11"
  }
}

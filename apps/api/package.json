{
  "name": "ateva-api",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "nest start --watch --entryFile apps/api/src/main",
    "build": "nest build",
    "start": "nest start --entryFile apps/api/src/main",
    "start:prod": "node dist/apps/api/src/main",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "vitest run --pool=forks --no-file-parallelism --maxWorkers=1 --maxConcurrency=1 --exclude 'src/integration/**/*.spec.ts'",
    "test:integration": "node ../../scripts/check-integration-consent.mjs && for spec in src/integration/*.spec.ts; do DATABASE_URL=\"${TEST_DATABASE_URL:-postgresql://ateva:ateva-test@localhost:5433/ateva_test?schema=public}\" pnpm --filter @ateva/db exec prisma migrate reset --force && pnpm exec vitest run \"$spec\" --pool=forks --no-file-parallelism --maxWorkers=1 --maxConcurrency=1 || exit $?; done",
    "test:watch": "vitest",
    "test:cov": "vitest run --pool=forks --no-file-parallelism --maxWorkers=1 --maxConcurrency=1 --coverage"
  },
  "dependencies": {
    "@ateva/agent-protocol": "workspace:*",
    "@ateva/config": "workspace:*",
    "@ateva/db": "workspace:*",
    "@ateva/shared": "workspace:*",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "^12.0.4",
    "@nestjs/throttler": "^6.7.1",
    "@sentry/nestjs": "^11.9.0",
    "@sentry/profiling-node": "^11.9.0",
    "@types/cookie-parser": "^1.4.10",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "google-auth-library": "11.2.0",
    "helmet": "^8.3.0",
    "lru-cache": "^11.5.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "redis": "^6.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "semver": "^7.8.5",
    "stripe": "^23.0.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@ateva/eslint-config": "workspace:*",
    "@ateva/wait-attestation-bridge": "workspace:*",
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/ms": "2.1.0",
    "@types/node": "^26.6.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}

{
  "compilerOptions": {
    "declaration": false,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "paths": {
      "@ateva/agent-protocol": ["../../packages/agent-protocol/src"],
      "@ateva/config": ["../../packages/config/src"],
      "@ateva/db": ["../../packages/db/src"],
      "@ateva/shared": ["../../packages/shared/src"]
    },
    "resolveJsonModule": true,
    "rootDir": "../..",
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "target": "ES2022",
    "types": ["node", "vitest/globals"]
  },
  "exclude": ["node_modules", "dist", "**/*.spec.ts"],
  "include": ["src"]
}

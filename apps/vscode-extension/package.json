{
  "name": "ateva-vscode",
  "displayName": "Ateva",
  "version": "0.0.1",
  "publisher": "ateva",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/Harshit-sehgal/promptpay.git"
  },
  "engines": {
    "node": ">=22.0.0",
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:ateva.login",
    "onCommand:ateva.logout",
    "onCommand:ateva.showEarnings",
    "onCommand:ateva.toggleAds",
    "onCommand:ateva.toggleWaitTelemetry",
    "onCommand:ateva.openDashboard",
    "onCommand:ateva.reportFalseWait",
    "onCommand:ateva.showExperimentAssignment",
    "onCommand:ateva.toggleDetectorSource",
    "onCommand:ateva.triggerManualWait"
  ],
  "contributes": {
    "commands": [
      {
        "command": "ateva.login",
        "title": "Ateva: Login"
      },
      {
        "command": "ateva.logout",
        "title": "Ateva: Logout"
      },
      {
        "command": "ateva.showEarnings",
        "title": "Ateva: Show Earnings"
      },
      {
        "command": "ateva.toggleAds",
        "title": "Ateva: Toggle Ads"
      },
      {
        "command": "ateva.toggleWaitTelemetry",
        "title": "Ateva: Toggle Wait Telemetry"
      },
      {
        "command": "ateva.openDashboard",
        "title": "Ateva: Open Dashboard"
      },
      {
        "command": "ateva.reportFalseWait",
        "title": "Ateva: Report false wait detection"
      },
      {
        "command": "ateva.showExperimentAssignment",
        "title": "Ateva: Show detector experiment assignment"
      },
      {
        "command": "ateva.toggleDetectorSource",
        "title": "Ateva: Toggle detector source"
      },
      {
        "command": "ateva.triggerManualWait",
        "title": "Ateva: Report a wait (manual detection)"
      }
    ],
    "configuration": {
      "title": "Ateva",
      "properties": {
        "ateva.adsEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Show ads during opted-in AI wait telemetry"
        },
        "ateva.waitTelemetryEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Send detected AI wait-state telemetry to Ateva. Disabled by default; enable only after reviewing the privacy notice."
        },
        "ateva.attestationProvider": {
          "type": "string",
          "default": "",
          "description": "Independent wait-attestation provider identifier. Required only for earning-enabled waits.",
          "scope": "machine"
        },
        "ateva.attestationProviderUrl": {
          "type": "string",
          "default": "",
          "description": "HTTPS endpoint for the independently operated wait-attestation provider.",
          "scope": "machine"
        },
        "ateva.maxAdsPerHour": {
          "type": "number",
          "default": 6,
          "minimum": 1,
          "maximum": 12,
          "description": "Maximum ads shown per hour"
        },
        "ateva.inactivityTimeoutMs": {
          "type": "number",
          "default": 15000,
          "minimum": 3000,
          "maximum": 120000,
          "description": "Milliseconds of inactivity before detecting a wait state"
        },
        "ateva.quietMode.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable quiet hours \u2014 no ads shown during specified times"
        },
        "ateva.quietMode.start": {
          "type": "string",
          "default": "22:00",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "description": "Quiet hours start time (HH:MM, 24h)"
        },
        "ateva.quietMode.end": {
          "type": "string",
          "default": "08:00",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "description": "Quiet hours end time (HH:MM, 24h)"
        },
        "ateva.apiUrl": {
          "type": "string",
          "default": "https://ateva.vercel.app/api/v1",
          "description": "Ateva API base URL",
          "scope": "machine"
        },
        "ateva.environmentKind": {
          "type": "string",
          "enum": [
            "development",
            "test",
            "sandbox",
            "staging",
            "production"
          ],
          "default": "production",
          "description": "Deployment environment label. Sandbox shows a persistent test-credits marker.",
          "scope": "machine"
        },
        "ateva.preferredDisplayCurrency": {
          "type": "string",
          "default": "",
          "description": "Preferred display currency for earnings (e.g. USD, EUR, JPY). Empty uses the derived primary currency. Only used when present in your balance; otherwise the primary currency is shown with a note."
        },
        "ateva.detectorRolloutPercent": {
          "type": "number",
          "default": 100,
          "minimum": 0,
          "maximum": 100,
          "description": "Staged rollout percentage (0-100) for detector experiments. Default 100 enrolls everyone."
        },
        "ateva.disabledDetectorSources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Detector signal sources to disable (e.g. inactivity, terminal, task, editor_idle)."
        },
        "ateva.falsePositiveSuppressionMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "maximum": 10080,
          "description": "How long (minutes) new waits/ads are suppressed after reporting a false positive."
        }
      }
    },
    "keybindings": [
      {
        "command": "ateva.reportFalseWait",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run bundle",
    "bundle": "pnpm --filter @ateva/shared build && node ./scripts/build.mjs && node ./scripts/verify-bundle.cjs",
    "compile": "tsc -p ./tsconfig.json",
    "watch": "tsc -watch -p ./tsconfig.json",
    "lint": "eslint src/ test/",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run bundle",
    "test": "vitest run",
    "package:vsix": "node ./scripts/package-vsix.mjs",
    "publish:vsix": "node ./scripts/package-vsix.mjs /tmp/ateva-vscode.vsix && vsce publish --packagePath /tmp/ateva-vscode.vsix"
  },
  "main": "./out/extension.js",
  "devDependencies": {
    "@ateva/agent-protocol": "workspace:*",
    "@types/node": "^26.4.0",
    "@types/vscode": "^1.134.0",
    "@vscode/vsce": "^3.9.2",
    "@ateva/eslint-config": "workspace:*",
    "@ateva/shared": "workspace:*",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Ads, telemetry and API access are disabled in an untrusted workspace: this extension holds a Ateva access token and sends it to a configurable API origin, so an untrusted folder must not be able to influence where it connects.",
      "restrictedConfigurations": [
        "ateva.apiUrl",
        "ateva.attestationProvider",
        "ateva.attestationProviderUrl",
        "ateva.environmentKind"
      ]
    }
  }
}

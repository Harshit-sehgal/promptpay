{
  "name": "ateva-web",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "prebuild": "node scripts/verify-deploy-env.mjs",
    "build": "NODE_ENV=production next build --webpack",
    "start": "next start",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@ateva/shared": "workspace:*",
    "@ateva/ui": "workspace:*",
    "@sentry/nextjs": "^10.75.2",
    "@tailwindcss/postcss": "^4.3.3",
    "axios": "^1.20.0",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ateva/eslint-config": "workspace:*",
    "@axe-core/playwright": "^4.14.0",
    "@next/eslint-plugin-next": "^16.4.3",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.31",
    "typescript": "^5.9.2",
    "vitest": "^4.1.12"
  }
}

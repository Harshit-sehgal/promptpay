{
  "name": "ateva-web",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "prebuild": "node scripts/verify-deploy-env.mjs",
    "build": "NODE_ENV=production next build --webpack",
    "start": "next start",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.70.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@ateva/shared": "workspace:*",
    "@ateva/ui": "workspace:*",
    "axios": "^1.19.0",
    "jose": "^6.2.10",
    "lucide-react": "^1.33.0",
    "next": "^16.3.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/eslint-plugin-next": "^16.3.2",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@ateva/eslint-config": "workspace:*",
    "autoprefixer": "^10.5.4",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.26",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
